+"""EXPERIMENT ONLY: compare partial-day target policies pending owner choice.
+
+Clinical duty/leave validation is unchanged. This helper weights the existing
+canonical active leave bands, not entitlement, attendance or actual working hours.
+"""
+from app.services.leave_semantics import is_active, leave_intervals, union_intervals
+
+PARTIAL_DAY_POLICY = 'fractional'
+
+
+def posted_capacity(person_id, days, leaves):
+    total = 0.0
+    for day in days:
+        spans = union_intervals(span
+            for leave in leaves.get(day, {}).get(person_id, []) if is_active(leave.status)
+            for span in leave_intervals(leave, day, day))
+        blocked = sum((s.ends_at-s.starts_at).total_seconds() for s in spans)/86400
+        remaining = max(0.0, min(1.0, 1-blocked))
+        total += remaining if PARTIAL_DAY_POLICY == 'fractional' else int(remaining > 0)
+    return total
