    "test:generation-controls": "node tests/generation-controls.browser.mjs",
    "test:webgpu": "node tests/webgpu-recovery.browser.mjs",
    "test:webgpu-production": "node tests/webgpu-production.browser.mjs",
    "test:intelligence": "node tests/intelligence.browser.mjs",
    "test:navigation": "node tests/navigation.browser.mjs",
    "test:ux-audit": "node tests/ux-audit.browser.mjs",
    "test:keyboard": "node tests/keyboard.browser.mjs",
    "test:import-review": "node tests/import-review.browser.mjs",
    "test:duplicates": "node tests/member-duplicates.browser.mjs",
    "test:clear-all": "node tests/member-bulk.browser.mjs",
